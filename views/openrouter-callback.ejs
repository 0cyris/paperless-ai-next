<!DOCTYPE html>
<html lang="en" class="h-full<%= theme === 'dark' ? ' dark' : '' %>" data-theme="<%= theme || 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connecting OpenRouter - Paperless-AI next</title>
    <link rel="icon" type="image/webp" href="/favicon.webp">
    <%- include('partials/shell/theme-init-head') %>
    <link rel="stylesheet" href="/css/darkmode.css">
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-secondary, #f3f4f6);
            color: var(--text-primary, #111827);
        }
        .callback-card {
            text-align: center;
            padding: 2rem;
            max-width: 420px;
        }
        .spinner {
            width: 32px;
            height: 32px;
            margin: 0 auto 1rem;
            border-radius: 50%;
            border: 3px solid rgba(59, 130, 246, 0.25);
            border-top-color: #3b82f6;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="callback-card">
        <div class="spinner" id="callbackSpinner"></div>
        <h1 id="callbackTitle" style="font-size: 1.1rem; font-weight: 600;">Completing OpenRouter sign-in&hellip;</h1>
        <p id="callbackMessage" style="font-size: 0.9rem; opacity: 0.75;">This window will close automatically.</p>
    </div>
    <script>
        (function () {
            var params = new URLSearchParams(window.location.search);
            var code = params.get('code');
            var titleEl = document.getElementById('callbackTitle');
            var messageEl = document.getElementById('callbackMessage');
            var spinnerEl = document.getElementById('callbackSpinner');

            if (!code) {
                spinnerEl.style.display = 'none';
                titleEl.textContent = 'Sign-in failed';
                messageEl.textContent = 'No authorization code was returned. You can close this window.';
                return;
            }

            // Hand the code back via localStorage + the "storage" event rather
            // than (only) window.opener.postMessage: OpenRouter's own page sets
            // a Cross-Origin-Opener-Policy header, which severs window.opener
            // once this popup navigates there — permanently, even after it
            // redirects back to our own origin. localStorage/storage events are
            // unaffected by COOP since they don't depend on the opener link.
            try {
                localStorage.setItem(
                    'openrouterOauthCode',
                    JSON.stringify({ code: code, ts: Date.now() })
                );
            } catch (storageError) {
                // Ignore — the postMessage fallback below still gets a chance.
            }

            if (window.opener) {
                try {
                    window.opener.postMessage(
                        { type: 'openrouter-oauth-code', code: code },
                        window.location.origin
                    );
                } catch (postMessageError) {
                    // Ignore — localStorage already carries the code.
                }
            }

            window.close();

            spinnerEl.style.display = 'none';
            titleEl.textContent = 'Sign-in complete';
            messageEl.textContent = 'You can close this window and return to the Paperless-AI next tab.';
        })();
    </script>
</body>
</html>
